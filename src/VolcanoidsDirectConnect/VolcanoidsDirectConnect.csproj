<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds against the game's own DLLs. Pass the game folder:
      dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Volcanoids"
    (BepInEx must already be installed in that folder.)
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VolcanoidsDirectConnect</AssemblyName>
    <RootNamespace>VolcanoidsDirectConnect</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.2.0</Version>
    <Managed>$(GameDir)\Volcanoids_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == '' Or !Exists('$(Managed)\Volcanoids.dll')"
           Text="Set GameDir to your Volcanoids folder, e.g. -p:GameDir=&quot;D:\SteamLibrary\steamapps\common\Volcanoids&quot; (got '$(GameDir)')." />
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')" Text="BepInEx is not installed in $(GameDir). Run setup.bat once first." />
  </Target>

  <ItemGroup>
    <Reference Include="$(Managed)\mscorlib.dll" Private="false" />
    <Reference Include="$(Managed)\netstandard.dll" Private="false" />
    <Reference Include="$(Managed)\System.dll" Private="false" />
    <Reference Include="$(Managed)\System.Core.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.MultiplayerHLAPI.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\Volcanoids.dll" Private="false" />
    <Reference Include="$(Managed)\Steamworks.NET.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.dll" Private="false" />
  </ItemGroup>
</Project>
